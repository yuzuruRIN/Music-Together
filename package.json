{
  "name": "music-together",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ฟังเพลงด้วยกันแบบเรียลไทม์ — สร้างปาร์ตี้ แชร์โค้ด แล้วฟังพร้อมกัน",
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"node --watch --env-file-if-exists=.env server/index.js\" \"vite\"",
    "dev:mock": "cross-env MOCK_YT=1 npm run dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "start:mock": "cross-env MOCK_YT=1 node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=22.9"
  }
}
